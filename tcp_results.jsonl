{"test_id": "P1; W256K; L4096; R1", "status": "success", "streams": 1, "window": "256K", "length": 4096, "repeat": 1, "duration": 30, "throughput_sender_bps": 72985005.6519804, "throughput_receiver_bps": 72910740.96768644, "retransmissions": 0, "router_samples": [{"timestamp": "2026-02-16T15:55:59.292619", "metrics": {"cpu_counters": {"user": 16198, "nice": 501, "system": 34694, "idle": 5514534, "iowait": 2022, "irq": 0, "softirq": 400106, "steal": 0}, "interfaces": {"enp0s8": {"rx_bytes": 20580762353, "rx_passions(data):

    tests = sorted(data.keys())

    retrans_avg = [
        sum(d["retrans"] for d in data[t]) / len(data[t])
        for t in tests
    ]

    plt.figure()
    plt.plot(tests, retrans_avg, marker="o")

    plt.xticks(rotation=45, ha="right")
    plt.xlabel("Test ID")
    plt.ylabel("Retransmissions")
    plt.title("Retransmissions per Test")
    plt.grid(True)


# ==================================================
# PLOT 4 — CPU USAGE PER TEST
# ==================================================
def plot_cpu_usage(data):

    tests = sorted(data.keys())
    cpu_avg = []

    for t in tests:

        cpu_values = [
            compute_cpu_percent(d["samples"])
            for d in data[t]
        ]

        cpu_avg.append(
            sum(cpu_values) / len(cpu_values)
            if cpu_values else 0
        )

    plt.figure()
    plt.plot(tests, cpu_avg, marker="o")

    plt.xticks(rotation=45, ha="right")
    plt.xlabel("Test ID")
    plt.ylabel("CPU Usage (%)")
    plt.title("Router CPU Usage per Test")
    plt.grid(True)


# ==================================================
# PLOT 5 — INTERFACE THROUGHPUT PER TEST
# ==================================================
def plot_interface_throughput(data):

    tests = sorted(data.keys())
    rates = []

    for t in tests:

        total = 0
        count = 0

        for d in data[t]:

            samples = d["samples"]

            valid = [
                s for s in samples
                if "interfaces" in s.get("metrics", {})
            ]

            if len(valid) < 2:
                continue

            first = valid[0]["metrics"]["interfaces"]
            last = valid[-1]["metrics"]["interfaces"]

            for iface in first:

                rx_diff = (
                    last[iface]["rx_bytes"] -
                    first[iface]["rx_bytes"]
                )

                total += rx_diff
                count += 1

        rates.append(total / count if count else 0)

    plt.figure()
    plt.plot(tests, rates, marker="o")

    plt.xticks(rotation=45, ha="right")
    plt.xlabel("Test ID")
    plt.ylabel("RX Bytes (Delta)")
    plt.title("Interface Throughput per Test")
    plt.grid(True)


# ==================================================
# PLOT 6 — SUCCESS RATE (FEASIBILITY)
# ==================================================
def plot_success_rate(records):

    counts = defaultdict(lambda: {"ok": 0, "total": 0})

    for r in records:
        key = r.get("test_id", "unknown")
        counts[key]["total"] += 1

        if r.get("status") == "success":
            counts[key]["ok"] += 1

    tests = sorted(counts.keys())

    rates = [
        counts[t]["ok"] / counts[t]["total"]
        for t in tests
    ]

    plt.figure()
    plt.plot(tests, rates, marker="o")

    plt.xticks(rotation=45, ha="right")
    plt.ylabel("Success Rate")
    plt.title("Feasibility per Test")
    plt.ylim(0, 1.05)
    plt.grid(True)

# PLOT 7 — FAILURE TYPE DISTRIBUTION

def plot_failure_types(failures):

    errors = Counter(
        r.get("error", "unknown")
        for r in failures
    )

    if not errors:
        return

    plt.figure()
    plt.bar(errors.keys(), errors.values())

    plt.xticks(rotation=45, ha="right")
    plt.ylabel("Occurrences")
    plt.title("Failure Type Distribution")
    plt.grid(True)


# MAIN
def main():

    records = load_data("tcp_results.jsonl")

    success, failure = success_failure(records)

    data = summarize_by_test(success)

    plot_throughput(data, failure)
    plot_sender_vs_receiver(data)
    plot_retransmissions(data)
    plot_cpu_usage(data)
    plot_interface_throughput(data)
    plot_success_rate(records)
    plot_failure_types(failure)

    plt.tight_layout()
    plt.show()


